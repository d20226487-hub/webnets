# Only needed for the Traefik deploy (docker-compose.traefik.yml). Copy to .env and fill in.
# The local Docker gallery (start-gallery.bat / docker compose up -d) does not read this file.

# Public hostname Traefik routes to this stack (informational; the router lives in Traefik's dynamic config).
SITE_HOST=website-gallery.mrba-stage1.xyz

# HTTP basic auth at the Caddy reverse proxy. Required: Caddy fails to start if these are unset.
# Generate a bcrypt hash:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'YOUR-PASS'
# Paste the entire output (starts with "$2a$") as BASIC_AUTH_PASSWORD_HASH.
# IMPORTANT: escape every `$` as `$$` in this file, or Compose treats it as a variable:
#   BASIC_AUTH_PASSWORD_HASH=$$2a$$14$$abcdef...
BASIC_AUTH_USERNAME=admin
BASIC_AUTH_PASSWORD_HASH=
