{
  "type": "app-multi",
  "title": "Multi-page brand app download",
  "brief": "docs/briefs/02-app-download.md",
  "frame": {
    "top": [
      {
        "block": "compliance-bar",
        "variants": ["strip", "ribbon"],
        "when": "market.strip"
      }
    ],
    "header": {
      "block": "header",
      "variants": [
        "inline",
        "centered"
      ],
      "props": {
        "sticky": false
      }
    },
    "footer": {
      "block": "footer",
      "variants": [
        "compact",
        "columns",
        "centered"
      ]
    },
    "overlay": [
      {
        "block": "age-gate"
      },
      {
        "block": "sticky-cta",
        "variants": [
          "app-banner"
        ]
      }
    ]
  },
  "pages": {
    "home": {
      "rule": "required",
      "nav": "nav.home",
      "_note": "The one-page app page plus links to the other pages. A store look (play / appstore) switches it to that store listing (layouts).",
      "sections": [
        {
          "id": "hero",
          "block": "app-hero",
          "zone": "top",
          "rule": "required"
        },
        {
          "id": "trust",
          "block": "trust-bar",
          "zone": "top",
          "rule": "required"
        },
        {
          "id": "screens",
          "block": "screenshots",
          "zone": "top",
          "rule": "required"
        },
        {
          "id": "features",
          "block": "features",
          "zone": "middle",
          "rule": "required"
        },
        {
          "id": "guides",
          "block": "page-links",
          "zone": "middle",
          "rule": "optional"
        },
        {
          "id": "install",
          "block": "install-guide",
          "zone": "middle",
          "rule": "apk"
        },
        {
          "id": "info",
          "block": "app-info",
          "zone": "middle",
          "rule": "required"
        },
        {
          "id": "whatsnew",
          "block": "changelog",
          "zone": "middle",
          "rule": "optional"
        },
        {
          "id": "faq",
          "block": "faq",
          "zone": "bottom",
          "rule": "required"
        },
        {
          "id": "final",
          "block": "download-panel",
          "zone": "bottom",
          "rule": "required"
        }
      ],
      "order_rules": [
        {
          "rule": "before",
          "a": "features",
          "b": "whatsnew"
        },
        {
          "rule": "not_first",
          "a": "whatsnew"
        },
        {
          "rule": "before",
          "a": "features",
          "b": "guides"
        }
      ],
      "angles": {
        "official-app": {
          "optional": [
            "whatsnew",
            "guides"
          ],
          "variants": {
            "hero": [
              "listing",
              "device"
            ]
          }
        },
        "live-in-pocket": {
          "optional": [
            "whatsnew",
            "guides"
          ],
          "variants": {
            "hero": [
              "device",
              "listing"
            ]
          }
        },
        "apk-easy": {
          "optional": [
            "guides"
          ],
          "variants": {
            "hero": [
              "device",
              "listing"
            ],
            "install": [
              "side-by-side",
              "tabs"
            ]
          }
        },
        "fast-app": {
          "optional": [
            "guides"
          ],
          "variants": {
            "hero": [
              "qr-first",
              "listing"
            ]
          }
        }
