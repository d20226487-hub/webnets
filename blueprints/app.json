{
  "type": "app",
  "title": "One-page brand app download",
  "brief": "docs/briefs/02-app-download.md",
  "frame": {
    "top": [
      {
        "block": "compliance-bar",
        "variants": ["strip", "ribbon"],
        "when": "market.strip"
      }
    ],
    "header": {
      "block": "header",
      "variants": [
        "app-bar"
      ],
      "props": {
        "sticky": false
      }
    },
    "footer": {
      "block": "footer",
      "variants": [
        "compact",
        "centered"
      ]
    },
    "overlay": [
      {
        "block": "age-gate"
      },
      {
        "block": "sticky-cta",
        "variants": [
          "app-banner"
        ]
      }
    ]
  },
  "sections": [
    {
      "id": "hero",
      "block": "app-hero",
      "zone": "top",
      "rule": "required"
    },
    {
      "id": "trust",
      "block": "trust-bar",
      "zone": "top",
      "rule": "required"
    },
    {
      "id": "screens",
      "block": "screenshots",
      "zone": "top",
      "rule": "required"
    },
    {
      "id": "features",
      "block": "features",
      "zone": "middle",
      "rule": "required"
    },
    {
      "id": "install",
      "block": "install-guide",
      "zone": "middle",
      "rule": "apk"
    },
    {
      "id": "info",
      "block": "app-info",
      "zone": "middle",
      "rule": "required"
    },
    {
      "id": "whatsnew",
      "block": "changelog",
      "zone": "middle",
      "rule": "optional"
    },
    {
      "id": "faq",
      "block": "faq",
      "zone": "bottom",
      "rule": "required"
    },
    {
      "id": "final",
      "block": "download-panel",
      "zone": "bottom",
      "rule": "required"
    }
  ],
  "order_rules": [
    {
      "rule": "before",
      "a": "features",
      "b": "whatsnew"
    },
    {
      "rule": "not_first",
      "a": "whatsnew"
    }
  ],
  "angles": {
    "official-app": {
      "optional": [
        "whatsnew"
      ],
      "variants": {
        "hero": ["listing", "device", "banner", "stage", "catalog", "apk-page", "hub"]
      }
    },
    "live-in-pocket": {
      "optional": [
        "whatsnew"
      ],
      "variants": {
        "hero": ["device", "listing", "banner", "stage", "catalog", "apk-page", "hub"]
      },
      "requires_vertical": "sports"
    },
    "apk-easy": {
      "optional": [],
      "variants": {
        "hero": ["device", "listing", "banner", "stage", "catalog", "apk-page", "hub"],
        "install": [
          "side-by-side",
          "tabs"
        ]
      },
      "requires_apk": true
    },
    "fast-app": {
      "optional": [],
      "variants": {
        "hero": ["qr-first", "listing", "banner", "stage", "catalog", "apk-page", "hub"]
      }
    }
  },
  "layouts": {
    "_note": "A look with a layout replaces the section list and order: the page follows that store listing. Variants are fixed per section.",
    "play": [
      {
        "id": "hero",
        "block": "store-header",
        "zone": "top",
        "rule": "required",
        "variant": "play"
      },
      {
        "id": "screens",
        "block": "screenshots",
        "zone": "middle",
        "rule": "required",
        "variant": "carousel"
      },
      {
        "id": "about",
        "block": "store-about",
        "zone": "middle",
        "rule": "required",
        "variant": "play"
      },
      {
        "id": "safety",
        "block": "app-privacy",
        "zone": "middle",
        "rule": "required",
        "variant": "play"
      },
      {
        "id": "reviews",
        "block": "store-reviews",
        "zone": "middle",
        "rule": "required",
        "variant": "play"
      },
      {
        "id": "whatsnew",
        "block": "changelog",
        "zone": "middle",
        "rule": "required",
        "variant": "list"
      },
      {
        "id": "faq",
        "block": "faq",
        "zone": "middle",
        "rule": "required"
      },
      {
        "id": "final",
        "block": "download-panel",
        "zone": "bottom",
        "rule": "required",
        "variant": "panel"
      }
    ],
    "appstore": [
      {
        "id": "hero",
        "block": "store-header",
        "zone": "top",
        "rule": "required",
        "variant": "appstore"
      },
      {
        "id": "whatsnew",
        "block": "changelog",
        "zone": "middle",
        "rule": "required",
        "variant": "list"
      },
      {
        "id": "screens",
        "block": "screenshots",
        "zone": "middle",
        "rule": "required",
        "variant": "carousel"
      },
      {
        "id": "about",
        "block": "store-about",
        "zone": "middle",
        "rule": "required",
        "variant": "appstore"
      },
      {
        "id": "reviews",
        "block": "store-reviews",
        "zone": "middle",
        "rule": "required",
        "variant": "appstore"
      },
      {
        "id": "privacy",
        "block": "app-privacy",
        "zone": "middle",
        "rule": "required",
        "variant": "appstore"
      },
      {
        "id": "info",
        "block": "app-info",
        "zone": "middle",
        "rule": "required",
        "variant": "table"
      },
      {
        "id": "faq",
        "block": "faq",
        "zone": "middle",
        "rule": "required"
      },
      {
        "id": "final",
        "block": "download-panel",
        "zone": "bottom",
        "rule": "required",
        "variant": "panel"
      }
    ]
  }
}
